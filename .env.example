# Copy to .env (gitignored) and fill in. Real environment variables take precedence over this file.
# Every variable is required: services refuse to start if one is missing.

# --- JWT (shared by auth-service and api-gateway; must be Base64, >= 32 bytes decoded) ---
#   openssl rand -base64 48
JWT_SECRET=

# --- Service-to-service key (gateway -> services, services -> services) ---
#   openssl rand -hex 32
INTERNAL_API_KEY=

# --- Database (also read by docker-compose.yml): one Postgres, a schema + login role per service ---
# Superuser password; services never use it. Generate: openssl rand -base64 24
DB_ADMIN_PASSWORD=
# Passwords of the per-service roles users_svc / auth_svc / authz_svc
USERS_DB_PASSWORD=
AUTH_DB_PASSWORD=
AUTHZ_DB_PASSWORD=
CART_DB_PASSWORD=
# Password of the read-only role "readonly" (SELECT on all schemas; shared with students)
READONLY_DB_PASSWORD=

# --- Initial admin user created by user-service on first start ---
ADMIN_PASSWORD=

# --- Server deployment only (docker-compose.prod.yml) ---
# Public domain whose DNS A record points to the server; Caddy gets a Let's Encrypt certificate for it.
# Leave empty/unset to run on https://localhost with a self-signed certificate.
DOMAIN=
